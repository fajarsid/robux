/// Telegram numeric user ID is the external identity anchor; usernames are mutable snapshots.
model TelegramIdentity {
  telegramUserId BigInt   @id @map("telegram_user_id")
  chatId         BigInt   @map("chat_id")
  username       String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  orders TelegramOrder[]

  @@map("telegram_identities")
}

model TelegramBotUpdate {
  updateId   BigInt   @id @map("update_id")
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  @@map("telegram_bot_updates")
}

/// Links Core orders to a Telegram identity without duplicating customer or order records.
model TelegramOrder {
  orderId        String   @id @map("order_id") @db.Uuid
  telegramUserId BigInt   @map("telegram_user_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  paymentNotifiedAt   DateTime? @map("payment_notified_at") @db.Timestamptz(3)
  fulfilledNotifiedAt DateTime? @map("fulfilled_notified_at") @db.Timestamptz(3)

  order    Order            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  identity TelegramIdentity @relation(fields: [telegramUserId], references: [telegramUserId], onDelete: Restrict)

  @@index([telegramUserId, createdAt(sort: Desc)])
  @@map("telegram_orders")
}

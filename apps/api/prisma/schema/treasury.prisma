enum TreasuryAsset {
  TON
  USDT

  @@map("treasury_asset")
}

enum TreasuryDirection {
  INBOUND
  OUTBOUND

  @@map("treasury_direction")
}

enum TreasuryTransactionType {
  BINANCE_REFILL
  TON_SUPPLIER_PAYMENT
  TON_GAS
  TON_SWAP
  MANUAL_ADJUSTMENT

  @@map("treasury_transaction_type")
}

enum TreasuryTransactionStatus {
  REQUESTED
  PROCESSING
  SUBMITTED
  CONFIRMED
  FAILED
  RECONCILIATION_REQUIRED

  @@map("treasury_transaction_status")
}

/// Treasury transaction metadata only. Signing keys and credentials are never persisted here.
model TreasuryTransaction {
  id                String                   @id @default(uuid(7)) @db.Uuid
  idempotencyKey    String                   @unique @map("idempotency_key") @db.VarChar(128)
  transactionType  TreasuryTransactionType  @map("transaction_type")
  asset             TreasuryAsset
  amountNano        BigInt                   @map("amount_nano")
  direction         TreasuryDirection
  provider          String                   @db.VarChar(40)
  externalReference String?                  @map("external_reference") @db.VarChar(255)
  destinationAddress String?                 @map("destination_address") @db.VarChar(128)
  status            TreasuryTransactionStatus @default(REQUESTED)
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  confirmedAt       DateTime?                @map("confirmed_at") @db.Timestamptz(3)
  updatedAt         DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, createdAt])
  @@unique([provider, externalReference], map: "treasury_transactions_provider_reference_key")
  @@map("treasury_transactions")
}

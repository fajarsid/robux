{
  "name": "robux-fulfillment",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "build": "corepack pnpm --filter @robux/shared run build && corepack pnpm --filter @robux/api --filter @robux/web run build",
    "lint": "corepack pnpm -r run lint",
    "typecheck": "corepack pnpm --filter @robux/shared run build && corepack pnpm -r run typecheck",
    "test": "corepack pnpm -r run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "secrets:scan": "sh scripts/scan-secrets.sh",
    "pm2:check": "sh scripts/check-no-pm2.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "globals": "^17.0.0",
    "prettier": "^3.6.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}

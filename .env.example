# -----------------------------------------------------------------------------
# Non-secret configuration for Docker Compose. Copy to `.env` and adjust.
# Secrets (passwords, keys, tokens) are NOT set here. They live in files under
# $SECRETS_DIR and are mounted with Compose `secrets:` (see secrets/README.md).
# Generate local secret files: ./scripts/generate-secrets.sh
# -----------------------------------------------------------------------------

# The Compose project name is fixed per environment in the override files (robux-dev,
# robux-prod). Do not set COMPOSE_PROJECT_NAME here: it would make both environments share
# one project and its database volume.

# Directory with application secret files. TLS certificates are host-managed under /etc/letsencrypt.
SECRETS_DIR=./secrets

# Local-only port used by the host Nginx reverse proxy. deploy.sh selects a free port if unset.
ROBUX_LOCAL_PORT=
CERTBOT_EMAIL=

# Image naming. The default "localhost/robux" can never resolve to a public Docker Hub namespace.
# Production: set to your private registry (e.g. ghcr.io/<org>) and IMAGE_TAG to the git SHA.
IMAGE_REGISTRY=localhost/robux
IMAGE_TAG=local

# Public hostnames routed by Nginx (ADR-002). In development *.localhost resolves to 127.0.0.1.
APP_DOMAIN=app.localhost
API_DOMAIN=api.localhost

# Exact browser origins trusted for state-changing requests (CSRF) and CORS (ADR-008).
# Development: http://app.localhost:8088   Production: https://app.<domain>
TRUSTED_ORIGINS=http://app.localhost:8088

# Development only: host port for Nginx (bound to 127.0.0.1).
NGINX_DEV_PORT=8088

# Logging: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# PostgreSQL (password comes from $SECRETS_DIR/postgres_password.txt)
POSTGRES_DB=robux
POSTGRES_USER=robux

# Payments (Phase 6, D-02, docs/integrations/duitku.md). Development Compose selects the local
# mock gateway; production configuration rejects it. `none` disables payment intake. With
# `duitku`, put merchant code and API key in secret files (never commit them).
PAYMENT_GATEWAY=none
PAYMENT_PROVIDER_STARS_ENABLED=false
TELEGRAM_STARS_PRODUCTION_AUTHORIZED=false
DUITKU_ENVIRONMENT=sandbox
# Public callback endpoint (API host) and customer return page (app host); https in production.
DUITKU_CALLBACK_URL=http://api.localhost:8088/api/v1/webhooks/payments/duitku
DUITKU_RETURN_URL=http://app.localhost:8088/payment/return
# Codes active in the Duitku project, comma-separated (supported set: docs/integrations/duitku.md §9).
DUITKU_PAYMENT_METHODS=
# Optional: only accept callbacks from these source IPs (Duitku's published list); empty = off.
DUITKU_CALLBACK_ALLOWED_IPS=

# --- Added in later phases (documented here so the full surface is visible) ---------------
# Phase 14: TELEGRAM_BOT_TOKEN, DISCORD_WEBHOOK_URL, SMTP credentials → secret files
# Phase 15 Telegram Mini App: keep credentials in an untracked local environment or secret manager.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_MINI_APP_URL=

# Phase 16: treasury requests are planning-only. Live Binance withdrawals and TON signing are not implemented.
TON_TREASURY_ENABLED=false
TON_TREASURY_PRODUCTION_AUTHORIZED=false
BINANCE_WITHDRAWAL_ENABLED=false
TON_TREASURY_MIN_BALANCE_NANO=20000000000
TON_TREASURY_TARGET_BALANCE_NANO=100000000000
TON_TREASURY_MAX_REFILL_NANO=100000000000
TON_TREASURY_DAILY_LIMIT_NANO=100000000000
TON_TREASURY_ALLOWED_ADDRESSES=

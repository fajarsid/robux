# Copy to /etc/robux/production.env and fill DOMAIN before setup-vps.sh.
DOMAIN=
API_DOMAIN_ALIAS=
NODE_ENV=production
LOG_LEVEL=info
API_HOST=127.0.0.1
API_PORT=8082
WEB_PORT=3211
PORT=3211
HOSTNAME=127.0.0.1
API_INTERNAL_URL=http://127.0.0.1:8082
WORKER_HEALTH_PORT=4081
SCHEDULER_HEALTH_PORT=4082
POSTGRES_DB=robux
POSTGRES_USER=robux
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_HOST_PORT=5433
POSTGRES_PASSWORD_FILE=/etc/robux/secrets/postgres_password.txt
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_HOST_PORT=6380
REDIS_PASSWORD_FILE=/etc/robux/secrets/redis_password.txt
SECRETS_DIR=/etc/robux/secrets
CSRF_SECRET_FILE=/etc/robux/secrets/csrf_secret.txt
TOTP_ENCRYPTION_KEY_FILE=/etc/robux/secrets/totp_encryption_key.txt
IDEMPOTENCY_ENCRYPTION_KEY_FILE=/etc/robux/secrets/idempotency_encryption_key.txt
ACCOUNT_INVENTORY_ENCRYPTION_KEY_FILE=/etc/robux/secrets/account_inventory_encryption_key.txt
DUITKU_MERCHANT_CODE_FILE=/etc/robux/secrets/duitku_merchant_code.txt
DUITKU_API_KEY_FILE=/etc/robux/secrets/duitku_api_key.txt
TELEGRAM_BOT_TOKEN_FILE=/etc/robux/secrets/telegram_bot_token.txt
TELEGRAM_WEBHOOK_SECRET_FILE=/etc/robux/secrets/telegram_webhook_secret.txt
PAYMENT_GATEWAY=none
PAYMENT_PROVIDER_STARS_ENABLED=false
TELEGRAM_STARS_PRODUCTION_AUTHORIZED=false
DUITKU_ENVIRONMENT=sandbox
DUITKU_PAYMENT_METHODS=
DUITKU_CALLBACK_ALLOWED_IPS=
TON_TREASURY_ENABLED=false
TON_TREASURY_PRODUCTION_AUTHORIZED=false
BINANCE_WITHDRAWAL_ENABLED=false
TON_SUPPLIER_ENABLED=false
FRAGMENT_ENABLED=false

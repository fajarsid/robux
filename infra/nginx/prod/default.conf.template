# Production internal edge. Public TLS and HTTP redirects are owned by host Nginx.
include /etc/nginx/snippets/http-common.conf;
map $http_x_forwarded_proto $forwarded_proto { default https; }

server {
  listen 8080 default_server;
  server_name _;
  location / { return 444; }
}

server {
  listen 8080;
  server_name ${APP_DOMAIN};
  include /etc/nginx/snippets/security-headers.conf;
  include /etc/nginx/snippets/app-locations.conf;
}

server {
  listen 8080;
  server_name ${API_DOMAIN};
  include /etc/nginx/snippets/security-headers.conf;
  include /etc/nginx/snippets/api-locations.conf;
}

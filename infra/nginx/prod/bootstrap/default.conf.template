# Temporary HTTP-only site. The normal TLS config replaces this after Certbot succeeds.
include /etc/nginx/snippets/http-common.conf;

server {
  listen 8080 default_server;
  server_name _;

  location ^~ /.well-known/acme-challenge/ {
    root /var/www/certbot;
    default_type text/plain;
    try_files $uri =404;
  }

  location = /nginx-health { return 200 "ok\n"; }
  location / { return 503 "TLS certificate setup in progress\n"; }
}
